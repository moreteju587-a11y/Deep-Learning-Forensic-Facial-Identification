# Copy this file to .env and fill in real values. Never commit .env itself.

# Flask session signing key — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQL connection string
DATABASE_URL=mysql+mysqlconnector://root:your_password@127.0.0.1:3306/thirdeye_db

# Password for the auto-created "admin" account (first run only).
# If left blank, a random one-time password is printed to the console instead.
ADMIN_PASSWORD=

# Used by /api/interpret-feature on the Face Constructor page for AI-assisted
# speech correction. Optional — keyword matching still works without it.
ANTHROPIC_API_KEY=

# Optional: where your Stable Diffusion model + VAE live (local folder path
# or a Hugging Face repo id). Defaults to public Hugging Face models if unset.
SD_MODEL_PATH=
SD_VAE_PATH=
